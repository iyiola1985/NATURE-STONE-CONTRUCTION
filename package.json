{
  "name": "nature-stone-construction",
  "private": true,
  "workspaces": ["web"],
  "scripts": {
    "build": "npm run build -w web",
    "dev": "npm run dev -w web",
    "dev:clean": "rm -rf web/.next web/node_modules/.cache && npm run dev",
    "dev:fresh": "npm run dev:fresh -w web",
    "lint": "npm run lint -w web",
    "start": "npm run start -w web",
    "verify:deploy": "npm run lint && npm run build",
    "verify:deploy:clean": "npm ci && npm run verify:deploy"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
